{
    "name": "oliezekat/smart-youtube-api-client",
    "type": "library",
    "description": "Save your time, bandwidth, storage, money... and Earth's climate too !",
    "keywords": ["youtube", "youtube-api", "youtube-client"],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "oliezekat",
            "email": "oliezekat@yahoo.fr",
            "homepage": "https://life2front.com/oliezekat/"
        }
    ],
    "require": {
        "php": "^8.1",
        "google/auth": "^1.37",
        "firebase/php-jwt": "^6.0||^7.0",
        "monolog/monolog": "^2.9||^3.0",
        "guzzlehttp/guzzle": "^7.4.5",
        "guzzlehttp/psr7": "^2.6"
    },
    "conflict": {
        "google/apiclient": "*",
        "google/apiclient-services": "*"
    },
    "autoload": {
        "psr-4": {
            "Google\\": "src/google/apiclient/src/",
            "Google\\Service\\": "src/google/apiclient-services/src/"
        },
        "files": [
            "src/google/apiclient/src/aliases.php",
            "src/google/apiclient-services/autoload.php"
        ],
        "classmap": [
            "src/google/apiclient/src/aliases.php"
        ]
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^13.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Oliezekat\\SmartYoutubeApiClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
	}
}
